
{{ 'component-header.css' | asset_url | stylesheet_tag }}

<header class="bh-header" data-sticky-header>

  <div class="bh-topbar">
    <div class="page-width bh-topbar-inner">

      <div class="bh-top-left">
        Authentic Global Products | Delivered to India
      </div>

      <div class="bh-top-right">
        <span>🇺🇸 USA</span>
        <span>🇬🇧 UK</span>
        <span>🇨🇦 Canada</span>
        <a href="#">Track Order</a>
        <a href="#">Help Center</a>
      </div>

    </div>
  </div>

  <div class="bh-main-header">
    <div class="page-width bh-main-inner">

      <button class="bh-mobile-toggle" aria-label="Menu">
        ☰
      </button>

      <a class="bh-logo" href="{{ routes.root_url }}">
        BuyHarbour
      </a>

      <div class="bh-search-wrapper">
        {% render 'header-search', input_id: 'Search-In-Modal' %}
      </div>

      <div class="bh-icons">

        <a href="{{ routes.account_login_url }}" class="bh-icon">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M4 21c2-4 6-6 8-6s6 2 8 6" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Account</span>
        </a>

        <a href="#" class="bh-icon">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.5-7 10-7 10Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"/>
          </svg>
          <span>Wishlist</span>
        </a>

        <a href="{{ routes.cart_url }}" class="bh-icon bh-cart">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <circle cx="9" cy="20" r="1.5"/>
            <circle cx="18" cy="20" r="1.5"/>
            <path d="M2 3h3l2.4 10h11.6l2-7H6" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>

          <span>Cart</span>

          {%- if cart.item_count > 0 -%}
            <span class="bh-cart-badge">
              {{ cart.item_count }}
            </span>
          {%- endif -%}
        </a>

      </div>

    </div>
  </div>

  <div class="bh-nav">
    <div class="page-width">

      <ul class="bh-nav-list">

        <li><a href="/collections/all">All Categories</a></li>

        <li><a href="/collections/usa">USA Store</a></li>

        <li><a href="/collections/uk">UK Store</a></li>

        <li><a href="/collections/canada">Canada Store</a></li>

        <li><a href="/collections/luxury">Luxury</a></li>

        <li><a href="/collections/best-sellers">Best Sellers</a></li>

        <li><a href="/collections/deals">Deals</a></li>

      </ul>

    </div>
  </div>

</header>

{% schema %}
{
  "name": "BuyHarbour Header",
  "class": "section-header",
  "settings": []
}
{% endschema %}