<link rel="stylesheet" href="{{ 'buyharbour.css' | asset_url }}" media="print" onload="this.media='all'"><script src="{{ 'buyharbour.js' | asset_url }}" defer></script>
<header class="bh-header">
  <div class="bh-topbar"><div class="bh-topbar__inner"><div class="bh-topbar__left"><span>Authentic Global Products</span><span>|</span><span>Delivered to India</span></div><div class="bh-topbar__right"><span>🇺🇸 USA</span><span>🇬🇧 UK</span><span>🇨🇦 Canada</span><span>Track Order</span><span>Help Center</span><span>{{ cart.currency.iso_code }}</span><span>{{ localization.language.iso_code | upcase }}</span></div></div></div>
  <div class="bh-mainbar"><a class="bh-logo" href="{{ routes.root_url }}">{{ shop.name }}</a><form class="bh-search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search for products, brands or anything global..." aria-label="Search"><button type="submit" aria-label="Search">⌕</button></form><div class="bh-actions">{% if shop.customer_accounts_enabled %}<a class="bh-action" href="{{ routes.account_url }}">♙ <span>Sign In</span></a>{% endif %}<a class="bh-action" href="{{ routes.cart_url }}">🛒 <span>Cart{% if cart.item_count > 0 %} {{ cart.item_count }}{% endif %}</span></a></div></div>
  <nav class="bh-nav" aria-label="Primary"><a href="{{ routes.all_products_collection_url }}">☰ All Categories</a><a href="{{ routes.all_products_collection_url }}">USA Store</a><a href="{{ routes.all_products_collection_url }}">UK Store</a><a href="{{ routes.all_products_collection_url }}">Canada Store</a><a href="{{ routes.all_products_collection_url }}">Luxury</a><a href="{{ routes.all_products_collection_url }}">Best Sellers</a><a href="{{ routes.all_products_collection_url }}">New Arrivals</a><a href="{{ routes.all_products_collection_url }}">Deals</a><a href="{{ routes.all_products_collection_url }}">Gift Cards</a></nav>
</header>
{% schema %}{"name":"BuyHarbour Header","settings":[],"presets":[{"name":"BuyHarbour Header"}]}{% endschema %}