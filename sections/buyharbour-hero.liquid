<div class="bh-shell bh-section"><section class="bh-hero"><div class="bh-hero__copy"><p style="font-weight:700;color:#0b66d4;margin:0 0 10px">🌍 Global shopping, made simple</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p><div class="bh-hero__actions"><a class="bh-btn bh-btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a><a class="bh-btn bh-btn--secondary" href="{{ section.settings.secondary_link }}">▶ {{ section.settings.secondary_label }}</a></div></div><div class="bh-hero__art">{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '500,750,1000', sizes: '(min-width:990px) 50vw, 100vw', alt: section.settings.heading | escape }}</div></section></div>
{% schema %}{"name":"BuyHarbour Hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"The World In Your Hands"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Authentic products from USA, UK & Canada. Delivered to India."},{"type":"text","id":"primary_label","label":"Primary label","default":"Shop All Products →"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"How It Works"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image","label":"Hero image"}],"presets":[{"name":"BuyHarbour Hero"}]}{% endschema %}