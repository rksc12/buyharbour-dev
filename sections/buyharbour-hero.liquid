<div class="bh-home bh-section"><section class="bh-hero-ref">
  <div class="bh-hero-ref__copy">
    <p class="bh-hero-ref__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="bh-hero-ref__subheading">{{ section.settings.subheading }}</p>
    <div class="bh-hero-ref__trust">
      {% for block in section.blocks %}
        <div class="bh-hero-ref__trust-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            {{ block.settings.icon | image_url: width: 64 | image_tag: loading:'lazy', widths:'32,64', sizes:'32px', alt:block.settings.label | escape }}
          {% endif %}
          <span>{{ block.settings.label }}</span>
        </div>
      {% endfor %}
    </div>
    <div class="bh-hero-ref__actions">
      <a class="bh-pill bh-pill--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      <a class="bh-pill bh-pill--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
  <div class="bh-hero-ref__art">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading:'eager', widths:'900,1200,1600,1800', sizes:'(min-width:990px) 58vw, 100vw', alt:section.settings.hero_alt | escape }}
    {% endif %}
    {% if section.settings.badge_image != blank %}
      <div class="bh-hero-ref__badge">
        {{ section.settings.badge_image | image_url: width: 420 | image_tag: loading:'lazy', widths:'210,320,420', sizes:'210px', alt:section.settings.badge_alt | escape }}
      </div>
    {% endif %}
  </div>
</section></div>
{% schema %}
{"name":"BuyHarbour Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Global shopping, made simple"},{"type":"text","id":"heading","label":"Heading","default":"The World In Your Hands"},{"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Authentic products from USA, UK & Canada.<br>Delivered to India.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop All Products →"},{"type":"url","id":"primary_link","label":"Primary link","default":"/collections/all"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"▶ How It Works"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"hero_image","label":"Hero artwork"},{"type":"text","id":"hero_alt","label":"Hero alt text","default":"Global products delivered to India"},{"type":"image_picker","id":"badge_image","label":"Global Brands badge artwork"},{"type":"text","id":"badge_alt","label":"Badge alt text","default":"Global Brands Happier You"}],"blocks":[{"type":"trust","name":"Trust item","limit":4,"settings":[{"type":"image_picker","id":"icon","label":"Icon"},{"type":"text","id":"label","label":"Label","default":"Global Shipping"}]}],"presets":[{"name":"BuyHarbour Hero","blocks":[{"type":"trust","settings":{"label":"Global Shipping"}},{"type":"trust","settings":{"label":"100% Authentic Products"}},{"type":"trust","settings":{"label":"Customs Handled"}},{"type":"trust","settings":{"label":"Dedicated Support"}}]}]}
{% endschema %}